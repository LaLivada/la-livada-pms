      "permanent": true,
      "has": [{ "type": "host", "value": "rezervari.lalivada.ro" }]
    },
    {
      "source": "/:pagina(termeni|livrare|anulare|retragere|confidentialitate|cookies)/index.html",
      "destination": "/:pagina/",
      "permanent": true,
      "has": [{ "type": "host", "value": "rezervari.lalivada.ro" }]
    },
    {
      "source": "/:pagina(termeni|livrare|anulare|retragere|confidentialitate|cookies)/:limba(en|fr|it|de|ru|uk)",
      "destination": "/:pagina/:limba/",
      "permanent": true,
      "has": [{ "type": "host", "value": "rezervari.lalivada.ro" }]
