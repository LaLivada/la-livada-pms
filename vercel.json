    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "rezervari.lalivada.ro" }]
    },
    {
      "source": "/:pagina(termeni|livrare|anulare|retragere|confidentialitate|cookies)",
